{
  "name": "cascada-vertical-slice-mes1",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "VERTICAL SLICE — NOT FOR PRODUCTION. Throwaway code validating Cascada FC full game loop. See README.md.",
  "scripts": {
    "smoke": "tsx src/sim/smoke.ts",
    "smoke:db": "tsx src/db/smoke-db.ts",
    "dev:api": "tsx watch src/api/server.ts",
    "dev:worker": "tsx watch src/api/workers/index.ts",
    "dev:web": "cd src/web && vite dev",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:setup": "npm run db:migrate && npm run db:seed",
    "db:generate": "drizzle-kit generate",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@types/node": "^22.0.0",
    "bullmq": "^5.21.0",
    "drizzle-orm": "^0.36.0",
    "hono": "^4.6.0",
    "@hono/node-server": "^1.13.0",
    "ioredis": "^5.4.0",
    "pg": "^8.13.0",
    "pino": "^9.5.0",
    "seedrandom": "^3.0.5",
    "socket.io": "^4.8.0",
    "uuid": "^11.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/pg": "^8.11.0",
    "@types/seedrandom": "^3.0.8",
    "@types/uuid": "^10.0.0",
    "drizzle-kit": "^0.28.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
