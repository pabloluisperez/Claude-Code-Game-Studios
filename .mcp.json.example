{
  "mcpServers": {
    "comfyui": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "tsx",
        "/Users/Shared/Projects/Claude-Code-Game-Studios/tools/comfyui-mcp/src/server.ts"
      ],
      "env": {
        "COMFYUI_URL": "http://bosgame.localdomain:8188",
        "COMFYUI_OUTPUT_DIR": "assets/sprites/_raw"
      }
    },
    "ssh-bosgame": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "ssh-mcp",
        "--",
        "--host=bosgame.localdomain",
        "--port=22",
        "--user=pablo",
        "--password=${SSH_BOSGAME_PASSWORD}"
      ],
      "env": {}
    }
  }
}
